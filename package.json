{
	"name": "orbit-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"dependencies": {
		"@blueprintjs/colors": "^4.1.3",
		"@blueprintjs/core": "^4.3.2",
		"@blueprintjs/select": "^4.4.1",
		"axios": "^1.7",
		"csvtojson": "^2.0.10",
		"dotenv": "^16.0.1",
		"grapheme-splitter": "^1.0.4",
		"history": "^5.3.0",
		"react": "^18.0",
		"react-dom": "^18.0",
		"react-router-dom": "^6.23.1",
		"restyped-axios": "^2.0.0",
		"simplebar-react": "^3.2.4",
		"web-vitals": "^2.1.4"
	},
	"scripts": {
		"start": "parcel -p 8000 ./src/index.html",
		"clear-cache": "rimraf ./dist ./.cache ./.parcel-cache",
		"build": "rimraf ./dist && parcel build --no-source-maps --no-autoinstall ./src/index.html",
		"deploy": "./bin/deploy.sh"
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"@babel/core": "^7.12.0",
		"@parcel/transformer-sass": "2.12.0",
		"@types/jest": "^27.5.1",
		"@types/node": "^16.11.36",
		"@types/react": "^18.0.9",
		"@types/react-dom": "^18.0.5",
		"@types/react-router": "^5.1.18",
		"@types/react-router-dom": "^5.3.3",
		"parcel": "^2.12.0",
		"process": "^0.11.10",
		"rimraf": "^3.0.2",
		"typescript": "^4.7.2"
	}
}
